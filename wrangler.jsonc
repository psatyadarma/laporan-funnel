{
  "name": "laporan-funnel",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "laporan", "database_id": "3eec6ea9-7012-4c71-854f-cc74befbcd4e", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "PUBLIC_BASE_URL": "",
    "PAYMENT_PROVIDER": "mayar",
    "MAYAR_API_BASE": "https://api.mayar.id/hl/v2",
    "AI_BASE_URL": "https://openrouter.ai/api/v1",
    "AI_MODEL": "anthropic/claude-sonnet-4.5"
  }
  // Secrets (set with `wrangler secret put NAME`, or in .dev.vars locally):
  // MAYAR_API_KEY, AI_API_KEY, ADMIN_KEY, META_CAPI_TOKEN
}
