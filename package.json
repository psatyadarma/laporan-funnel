{
  "name": "laporan-funnel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --local",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply laporan --local",
    "db:migrate:remote": "wrangler d1 migrations apply laporan --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
